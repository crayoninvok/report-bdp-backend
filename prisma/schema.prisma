// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SuperAdmin
  User
}

enum JobSite {
  MuaraPahu
  Senyiur
  HeadOffice
}

model Users {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  jobSite   JobSite  @default(MuaraPahu)
  role      UserRole @default(User)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WeeklyReport {
  id                  String             @id @default(uuid())
  jobSite             JobSite
  periodName          String             // e.g. "01-08 Okt 2026"
  startDate           DateTime
  endDate             DateTime
  year                Int
  weekNumber          Int
  budgetProduksi      Float              @default(0) // Ton
  realisasiProduksi   Float              @default(0) // Ton
  mtdBudgetProduksi   Float?             // Cumulative MTD from Excel column
  mtdRealisasiProduksi Float?            // Cumulative MTD from Excel column
  ytdBudgetProduksi   Float?             // Optional exact YTD Produksi Budget
  ytdRealisasiProduksi Float?            // Optional exact YTD Produksi Realisasi
  status              String             @default("Draft")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  items               WeeklyReportItem[]

  @@unique([jobSite, year, weekNumber])
}

model WeeklyReportItem {
  id               String       @id @default(uuid())
  reportId         String
  report           WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  accountCode      String?      // e.g. "05110101"
  accountName      String
  costBehavior     String?      // "VC" or "FC"
  accountGroup     String?      // "GKD", "SPP", etc.
  subCategory      String?      // "GAJI", "Salary", "Allowance", etc.
  isParent         Boolean      @default(false)
  parentName       String?      // Name of parent summary account
  orderIndex       Int          @default(0)
  budgetCost       Float        @default(0) // Input by Head Office (IDR)
  realisasiCost    Float        @default(0) // Input by Site (IDR)
  mtdBudgetCost    Float?       // Cumulative MTD from Excel column
  mtdRealisasiCost Float?       // Cumulative MTD from Excel column
  ytdBudgetCost    Float?       // Optional exact YTD Budget Cost
  ytdRealisasiCost Float?       // Optional exact YTD Realisasi Cost
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([reportId, accountName])
}

model PLSummaryOps {
  id                   String             @id @default(uuid())
  jobSite              JobSite
  year                 Int
  month                Int                // 1..12
  monthLabel           String             // "Jan", "Feb", etc.
  periodName           String             // "01-31 Jan 2026"
  budgetProduksi       Float              @default(0)
  realisasiProduksi    Float              @default(0)
  achProduksiPercent   Float              @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  items                PLSummaryOpsItem[]

  @@unique([jobSite, year, month])
}

model PLSummaryOpsItem {
  id                  String       @id @default(uuid())
  summaryId           String
  summary             PLSummaryOps @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  accountName         String
  orderIndex          Int          @default(0)
  budgetCost          Float        @default(0)
  budgetPercentNS     Float        @default(0)
  budgetIdrPerTon     Float        @default(0)
  realisasiCost       Float        @default(0)
  realisasiPercentNS  Float        @default(0)
  realisasiIdrPerTon  Float        @default(0)
  achPercent          Float        @default(0)
  costUnderOverPerTon Float?
  costUnderOver       Float?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([summaryId, accountName])
}

model RiverJournal {
  id              String   @id @default(uuid())
  externalId      Int?     // Kolom A: ID Spreadsheet
  date            String   // Kolom B: Tanggal (YYYY-MM-DD)
  inputTime       String   // Kolom C: Waktu Input (HH:mm)
  location        String   // Kolom D: Lokasi Pengukuran
  site            JobSite  // Senyiur atau MuaraPahu
  waterDepth      Float    // Kolom E: Kedalaman Air Sungai (m)
  minThreshold    Float    @default(4.0) // Kolom F: Batas Minimum Kedalaman (m)
  autoDescription String   // Kolom G: Deskripsi otomatis
  userInput       String   // Kolom H: User yang input
  conclusion      String   // Kolom I: Kesimpulan Data
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([site, date])
}

model DailyProduction {
  id           String    @id @default(uuid())
  jobSite      JobSite   @default(MuaraPahu)
  date         String    // Tanggal operasional (YYYY-MM-DD)
  weekNumber   String    // Kelompok Minggu: W01 - W53
  pa           Float     // Physical Availability decimal (0.9577)
  ua           Float     // Use of Availability decimal (0.4789)
  payload      Float     // Muatan rata-rata per ritase (Ton)
  cycleTime    Float     // Waktu edar rata-rata (Jam)
  fuelRatio    Float     // Konsumsi bahan bakar (L/Ton)
  unitRunning  Int       // Jumlah unit armada aktif
  tdp          Float     // Trip Per Day per unit armada
  production   Float     // Total produksi harian (Ton)
  notes        String?   // Catatan operasional harian
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([jobSite, date])
  @@index([jobSite, date])
  @@index([weekNumber])
}

model GLPeriod {
  id                String             @id @default(uuid())
  fileName          String
  periodName        String             // e.g. "01/10/26 To 23/10/26"
  year              Int
  month             Int                // 1..12
  startDate         DateTime?
  endDate           DateTime?
  totalDebet        Float              @default(0)
  totalTransactions Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  summaries         GLExpenseSummary[]
  transactions      GLTransaction[]

  @@unique([year, month, periodName])
  @@index([year, month])
}

model GLExpenseSummary {
  id          String   @id @default(uuid())
  periodId    String
  period      GLPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  accountCode String   // e.g. "05110101"
  accountName String   // e.g. "BEBAN GAJI KARYAWAN"
  hofAmount   Float    @default(0) // Head Office
  mphAmount   Float    @default(0) // Muara Pahu
  snyAmount   Float    @default(0) // Senyiur
  grandTotal  Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([periodId, accountCode])
  @@index([periodId])
}

model GLTransaction {
  id            String   @id @default(uuid())
  periodId      String
  period        GLPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  date          String   // YYYY-MM-DD
  regNo         String?  // Voucher / Reg No, e.g. "EP0126001206"
  controlNo     String?
  accountCode   String?  // e.g. "05110101"
  accountName   String   // e.g. "BEBAN GAJI KARYAWAN"
  accountGroup  String?  // e.g. "BEBAN KARYAWAN"
  currency      String   @default("IDR")
  costCenter    String?  // e.g. "HRD004"
  debet         Float    @default(0)
  credit        Float    @default(0)
  saldo         Float?
  projectArea   String?  // "MPH", "SNY", "HOF"
  materialCode  String?
  specification String?
  qty           Float?
  supplierName  String?
  remark        String?
  createdAt     DateTime @default(now())

  @@index([periodId])
  @@index([periodId, projectArea])
  @@index([periodId, accountCode])
  @@index([date])
}

model MasterUnit {
  id           String                   @id @default(uuid())
  unitCode     String                   @unique // e.g. "PM401", "ST801", "DL601", "ST901"
  unitNumber   Int                      // e.g. 401, 801, 601, 901
  category     String                   // "Prime Mover", "Vessel 1", "Dolly", "Vessel 2"
  brand        String                   // "Volvo", "Korindo", "CIMC"
  model        String                   // "FH16", "SDT110", "DL60", "SDT125"
  headUnitCode String?                  // e.g. "PM401"
  pairIndex    Int?                     // 1..71
  jobSite      JobSite                  @default(MuaraPahu)
  status       String                   @default("Active") // "Active", "Maintenance", "Breakdown", "Standby"
  currentHm    Float?                   // Engine Hours terakhir (live Volvo untuk PM, manual/PM untuk Support)
  currentKm    Float?                   // Odometer terakhir (live Volvo untuk PM, manual/PM untuk Support)
  inspections  PeriodicInspectionItem[]
  preventiveMaintenances PreventiveMaintenanceItem[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([category])
  @@index([headUnitCode])
  @@index([status])
}

model PeriodicInspectionPlan {
  id          String                   @id @default(uuid())
  jobSite     JobSite                  @default(MuaraPahu)
  date        String                   // YYYY-MM-DD
  targetUnits Int                      @default(9) // Plan harian (default 9, bisa diubah dinamis)
  leadInspector String?
  notes       String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  items       PeriodicInspectionItem[]

  @@unique([jobSite, date])
  @@index([date])
}

model PeriodicInspectionItem {
  id            String                 @id @default(uuid())
  planId        String
  plan          PeriodicInspectionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  date          String                 // YYYY-MM-DD
  unitCode      String                 // e.g. "PM401" (kepala)
  unit          MasterUnit?            @relation(fields: [unitCode], references: [unitCode])
  serviceType   String                 @default("PI Regular") // "PI Regular", "P1 (250 HM)", "P2 (500 HM)", "P3 (1000 HM)", "P4 (2000 HM)"
  shift         String                 @default("Shift 1") // "Shift 1", "Shift 2"
  status        String                 @default("Scheduled") // "Scheduled", "In Progress", "Completed", "Pending"
  inspectorName String?
  notes         String?
  buntutSummary String?                // e.g. "ST801, DL601, ST901"
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([planId, unitCode])
  @@index([date])
  @@index([unitCode])
  @@index([status])
}

model PreventiveMaintenancePlan {
  id           String                      @id @default(uuid())
  jobSite      JobSite                     @default(MuaraPahu)
  date         String                      // YYYY-MM-DD
  targetUnits  Int                         @default(4) // Plan harian PM (default 4, bisa diubah dinamis)
  leadMechanic String?
  notes        String?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  items        PreventiveMaintenanceItem[]

  @@unique([jobSite, date])
  @@index([date])
}

model PreventiveMaintenanceItem {
  id             String                    @id @default(uuid())
  planId         String
  plan           PreventiveMaintenancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  date           String                    // YYYY-MM-DD
  unitCode       String                    // e.g. "PM401" (kepala)
  unit           MasterUnit?               @relation(fields: [unitCode], references: [unitCode])
  serviceType    String                    @default("PS1 (12.000 KM)") // "PS1 (12.000 KM)", "PS2 (24.000 KM)", "PS3 (48.000 KM)", "P1 (250 HM)", "P2 (500 HM)", "P3 (1000 HM)", "P4 (2000 HM)", "Greasing & PS"
  shift          String                    @default("Shift 1") // "Shift 1", "Shift 2"
  status         String                    @default("Scheduled") // "Scheduled", "In Progress", "Completed", "Pending"
  category       String?                   @default("Scheduled PS") // "Scheduled PS", "Back-Log / Follow-up", "Breakdown / Unscheduled", "Overhaul / Major", "Greasing & Routine"
  planStartTime  String?                   // e.g. "08:00"
  planLeadTime   String?                   // e.g. "4 Jam"
  planHmServis   String?                   // e.g. "500 HM" atau target HM saat servis
  actualStartTime String?                  // Realisasi jam mulai aktual, e.g. "08:00"
  actualLeadTime String?                   // Realisasi lead time aktual, e.g. "9 Jam"
  actualHmServis Float?                    // Realisasi HM aktual saat servis (KPI Akurasi HM)
  supervisorName String?                   // Nama Pengawas (SPV Plant dari HR)
  mechanicName   String?                   // Gabungan nama mekanik (maks 5)
  mechanicNames  String[]                  @default([]) // Daftar nama mekanik dari HR (maks 5)
  currentKm      Float?                    // Odometer (KM) tercatat saat Periodic Service
  currentHm      Float?                    // Engine Hours (HM) tercatat saat Periodic Service
  nextDueKm      Float?                    // Target KM servis berikutnya
  nextDueHm      Float?                    // Target HM servis berikutnya
  notes          String?
  buntutSummary  String?                   // e.g. "ST801, DL601, ST901"
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([planId, unitCode])
  @@index([date])
  @@index([unitCode])
  @@index([status])
}

model PlantSetting {
  id          String   @id @default(uuid())
  jobSite     JobSite  @default(MuaraPahu)
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model MasterManpower {
  id                  String   @id @default(uuid())
  employeeId          String   @unique
  fullName            String
  statusKeaktifan     String?  // Exist, Exit
  barcode             String?
  organization        String?  // HSE, Hrga, Production, Plant, Operations, FA & Procurement, etc.
  jobPosition         String?  // Spv Hse, Spv Finance, Driver, etc.
  jobLevel            String?  // Worker, Junior Supervisor, Supervisor, Manager, Director
  joinDate            String?
  resignDate          String?
  statusEmployee      String?  // Contract, Permanent
  endDate             String?
  signDate            String?
  email               String?
  birthDate           String?
  age                 String?
  birthPlace          String?
  citizenIdAddress    String?
  residentialAddress  String?
  npwp                String?
  ptkpStatus          String?
  employeeTaxStatus   String?
  taxConfig           String?
  bankName            String?
  bankAccount         String?
  bankAccountHolder   String?
  bpjsKetenagakerjaan String?
  bpjsKesehatan       String?
  nik                 String?
  mobilePhone         String?
  phone               String?
  branchName          String?  // Muara Pahu, Senyiur, HO Jakarta
  parentBranchName    String?
  religion            String?
  gender              String?
  maritalStatus       String?
  bloodType           String?
  nationalityCode     String?
  currency            String?
  lengthOfService     String?
  paymentSchedule     String?
  approvalLine        String?
  manager             String?
  grade               String?
  className           String?
  profilePicture      String?
  costCenter          String?
  costCenterCategory  String?
  sbu                 String?
  pointOfHire         String?  // Lokal, Non Lokal
  tinggiBadan         String?
  beratBadan          String?
  ukuranBaju          String?
  ukuranCelana        String?
  warnaHelm           String?
  safetyShoes         String?
  tglTerakhirMcu      String?
  followUpMcu         String?
  trainingInternal    String?
  trainingExternal    String?
  sertifikasi         String?
  namaIbuKandung      String?
  pendidikan          String?
  jurusan             String?
  kota                String?
  provinsi            String?
  rawJson             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([statusKeaktifan])
  @@index([branchName])
  @@index([organization])
  @@index([jobPosition])
}
